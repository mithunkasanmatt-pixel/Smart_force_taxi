datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  TRANSPORT_MANAGER
  DRIVER
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  ON_TRIP
  MAINTENANCE
  OFFLINE
}

enum TripStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  ON_BREAK
  OFF_DUTY
  OFFLINE
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  password          String
  name              String
  role              Role           @default(DRIVER)
  employeeId        String         @unique
  phone             String?
  licenseNumber     String?
  licenseExpiry     DateTime?
  experience        Int?           // Years of experience
  shift             String?        // Morning, Evening, Night
  emergencyContact  String?
  status            DriverStatus   @default(OFFLINE)
  joiningDate       DateTime?
  shiftStartTime    String?        // "06:00 AM"
  shiftEndTime      String?        // "06:00 PM"
  shiftDuration     String?        // "12 Hours"
  
  // Relations
  trips             Trip[]         @relation("DriverTrips")
  weeklyLogs        WeeklyLog[]
  assignedVehicleId String?
  assignedVehicle   Vehicle?       @relation("DriverVehicle", fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([role])
  @@index([assignedVehicleId])
}

model Vehicle {
  id                 String         @id @default(uuid())
  vehicleNumber      String         @unique
  name               String
  brand              String
  model              String
  year               Int
  seatingCapacity    Int
  registrationNumber String         @unique
  insuranceExpiry    DateTime
  fcExpiry           DateTime       // Fitness Certificate
  pollutionExpiry    DateTime       // Pollution Certificate
  serviceDueDate     DateTime
  odometer           Int
  status             VehicleStatus  @default(AVAILABLE)
  carType            String?
  ownershipType      String?        // Own / Rental
  notes              String?
  imageUrl           String?
  
  // Relations
  trips              Trip[]
  assignedDrivers    User[]         @relation("DriverVehicle")

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status])
}

model Trip {
  id                String       @id @default(uuid())
  tripNumber        String       @unique
  requestedBy       String?
  department        String?
  pickup            String
  destination       String
  startTime         DateTime
  endTime           DateTime
  purpose           String
  status            TripStatus   @default(PENDING)
  notes             String?
  
  assignedBy        String?      // DRIVER or ADMIN
  
  // Relations
  driverId          String?
  driver            User?        @relation("DriverTrips", fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId         String
  vehicle           Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([driverId])
  @@index([vehicleId])
}

model WeeklyLog {
  id         String   @id @default(uuid())
  driverId   String
  driver     User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  imageUrl   String
  uploadedAt DateTime @default(now())
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([driverId])
}

